{
  "branches": ["main"],
  "tagFormat": "monster-hunt-counter-fork-v${version}",
  "extends": "semantic-release-monorepo",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "MOD_NAME=monster-hunt-counter-fork VERSION=${nextRelease.version} node ../../build.js && MOD_NAME=monster-hunt-counter-fork node ../../update-readme.js && git add ../../README.md"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "modinfo.ini"
        ],
        "message": "chore(monster-hunt-counter-fork): release v${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/*.zip",
            "label": "monster-hunt-counter-fork-v${nextRelease.version}.zip"
          }
        ]
      }
    ]
  ]
}
